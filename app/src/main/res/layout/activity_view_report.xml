<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darker_teal"
    tools:context=".ViewReport">


    <RelativeLayout
        android:id="@+id/mainToolbar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/darker_teal"
        android:padding="10dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_centerVertical="true">
            <ImageButton
                android:id="@+id/backBtn"
                android:layout_marginStart="10dp"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/back_icon"
                app:tint="@color/light_teal" />
            <TextView
                android:id="@+id/toolbarTitleTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textSize="20sp"
                android:textColor="@color/light_teal"
                android:text="Report"/>
        </LinearLayout>

    </RelativeLayout>

    <com.google.android.material.divider.MaterialDivider
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/mainToolbar"
        app:dividerColor="@color/light_teal" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/reportRefreshLayout"
        android:layout_below="@id/divider"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp">

                    <RelativeLayout
                        android:id="@+id/reportLayout"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:layout_marginTop="30dp">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/userCircleImageView"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/user_default_profile" />

                        <TextView
                            android:id="@+id/fullnameTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_above="@id/usernameTV"
                            android:layout_marginStart="20dp"
                            android:layout_marginBottom="8dp"
                            android:layout_toRightOf="@id/userCircleImageView"
                            android:contentDescription="@string/full_name"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/light_teal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/usernameTV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="20dp"
                            android:layout_marginBottom="8dp"
                            android:layout_toLeftOf="@id/createdTimestampTV"
                            android:layout_toRightOf="@id/userCircleImageView"
                            android:contentDescription="@string/Chats"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textColor="@color/light_teal"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/createdTimestampTV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="20dp"
                            android:layout_marginEnd="15dp"
                            android:layout_marginBottom="8dp"
                            android:contentDescription="@string/timestamp"
                            android:textColor="@color/light_teal"
                            android:textSize="14sp" />

                    </RelativeLayout>

                    <TextView
                        android:id="@+id/reasonTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:contentDescription="reason"
                        android:textColor="@color/light_teal"
                        android:textSize="16sp" />


                    <!-- FOR USER AND COMMUNITY PROFILE -->
                    <LinearLayout
                        android:id="@+id/profileCommunityLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@color/dark_teal"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:visibility="gone">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="280dp"
                            android:layout_below="@id/divider">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <ImageView
                                    android:id="@+id/bannerCoverIV"
                                    android:layout_width="match_parent"
                                    android:layout_height="180dp"
                                    android:src="@color/black" />
                            </RelativeLayout>

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <de.hdodenhof.circleimageview.CircleImageView
                                    android:id="@+id/communityProfileCIV"
                                    android:layout_width="130dp"
                                    android:layout_height="130dp"
                                    android:layout_alignParentBottom="true"
                                    android:layout_centerHorizontal="true"
                                    android:layout_marginBottom="20dp"
                                    android:src="@color/light_teal" />
                            </RelativeLayout>
                        </FrameLayout>

                        <TextView
                            android:id="@+id/communityProfileNameTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:backgroundTint="#00FFFFFF"
                            android:contentDescription="@string/user_description"
                            android:drawableTint="#00FFFFFF"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textAlignment="center"
                            android:textColor="@color/light_teal"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/communityProfileUserNameTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:backgroundTint="#00FFFFFF"
                            android:contentDescription="@string/user_description"
                            android:drawableTint="#00FFFFFF"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textAlignment="center"
                            android:textColor="@color/light_teal"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/communityProfileDescriptionTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:backgroundTint="#00FFFFFF"
                            android:contentDescription="@string/user_description"
                            android:drawableTint="#00FFFFFF"
                            android:textAlignment="center"
                            android:textColor="@color/light_teal"
                            android:textSize="16sp" />


                    </LinearLayout>


                    <!-- FOR IMAGE WITH CAPTION  -->

                    <LinearLayout
                        android:id="@+id/imageWithCaptionLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@color/dark_teal"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp"
                        android:visibility="gone">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="60dp">

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/reportedUserCIV"
                                android:layout_width="50dp"
                                android:layout_height="50dp"
                                android:src="@drawable/profile_not_selected" />

                            <TextView
                                android:id="@+id/reportedUserFullnameTV"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_above="@id/reportedUsernameTV"
                                android:layout_marginStart="20dp"
                                android:layout_marginBottom="8dp"
                                android:layout_toRightOf="@id/reportedUserCIV"
                                android:contentDescription="@string/full_name"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:textColor="@color/light_teal"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/reportedUsernameTV"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentBottom="true"
                                android:layout_marginStart="20dp"
                                android:layout_marginBottom="8dp"
                                android:layout_toLeftOf="@id/reportedPostCreatedTS"
                                android:layout_toRightOf="@id/reportedUserCIV"
                                android:contentDescription="@string/Chats"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:textColor="@color/light_teal"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/reportedPostCreatedTS"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_alignParentBottom="true"
                                android:layout_marginStart="20dp"
                                android:layout_marginEnd="15dp"
                                android:layout_marginBottom="8dp"
                                android:contentDescription="@string/timestamp"
                                android:textColor="@color/light_teal"
                                android:textSize="14dp" />

                        </RelativeLayout>

                        <ImageView
                            android:id="@+id/contentIV"
                            android:layout_width="300dp"
                            android:layout_height="300dp"
                            android:src="@drawable/baseline_image_24" />


                        <TextView
                            android:id="@+id/contentCaptionTV"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="Caption"
                            android:textColor="@color/light_teal"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/markAsReviewedBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="@color/teal"
                        android:text="Mark as reviewed"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/markAsNotReviewedBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="@color/teal"
                        android:text="Mark as not reviewed"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/deleteReportBtn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:backgroundTint="@color/red"
                        android:text="Delete Report"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/reviewedMessageTV"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:text="The report has already been reviewed"
                        android:textAlignment="center"
                        android:textColor="#7EFD62"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


</RelativeLayout>